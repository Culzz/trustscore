# API configuration. Copy to .env and fill in. Never commit .env.
#
# --- Model ---
MODEL_VERSION=trustscore-1.0.0
FAIR_MODEL_VERSION=trustscore-1.1.0
ENABLE_DOCS=true

# --- Prediction storage (anonymised logging + live drift baseline) ---
# storage_backend: auto | postgres | sqlite | none
#   auto  -> postgres if DATABASE_URL is set, else sqlite locally, else none on Vercel
#   sqlite -> zero-signup local file (great for development)
STORAGE_BACKEND=auto
LOG_PREDICTIONS=true
SQLITE_PATH=predictions.db

# Any Postgres connection string works. Free, no-card options:
#   Supabase  -> Project settings > Database > Connection string (URI)
#   Aiven     -> free 1GB Postgres, no card
#   Neon      -> free tier (a card may be requested)
# Example:
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# --- Async application jobs ---
# job_backend: auto | memory | celery
#   auto   -> celery when CELERY_BROKER_URL or REDIS_URL is set, else in-process
#   memory -> always in-process (the serverless-safe default)
#   celery -> always dispatch to a Celery worker (requires a broker)
#
# The WebSocket progress stream works wherever the process stays alive (Docker,
# Render, or `uvicorn` locally). On Vercel functions the client automatically
# falls back to polling GET /jobs/{id}.
JOB_BACKEND=auto
JOB_TTL_SECONDS=900

# Redis / Celery. Leave unset for the in-process backend.
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Drift / adversarial alerting ---
# Optional webhook (e.g. a Slack incoming-webhook URL). When set, drift alerts
# and POST /alerts/test are POSTed here as JSON. Leave unset to only generate.
# ALERT_WEBHOOK_URL=

# --- Privacy gateway (PII masking middleware) ---
# Direct identifiers in JSON bodies are replaced with a salted hash before they
# reach a handler. Change the salt in production so hashes are not portable.
PII_SALT=trustscore-demo-salt

# --- CORS (comma-separated browser origins) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Rate limiting (slowapi syntax) ---
RATE_LIMIT=120/minute
